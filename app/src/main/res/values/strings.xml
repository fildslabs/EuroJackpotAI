    <string name="mode_random_title">Random</string>
    <string name="mode_random_desc">A completely random combination. Every valid combination has exactly the same odds.</string>
    <string name="mode_balanced_title">Balanced</string>
    <string name="mode_balanced_desc">Numbers are spread across the 1–50 range and mix odd/even values, without weighting by past frequency.</string>
    <string name="mode_hot_title">Hot Numbers</string>
    <string name="mode_hot_desc">Favors numbers that have appeared more often in past draws.</string>
    <string name="mode_cold_title">Cold Numbers</string>
    <string name="mode_cold_desc">Favors numbers that have appeared less often, or not recently, in past draws.</string>
    <string name="mode_hot_cold_title">Hot + Cold</string>
    <string name="mode_hot_cold_desc">Mixes frequently and rarely drawn numbers into the same combination.</string>
    <string name="mode_statistical_mix_title">Statistical Mix</string>
    <string name="mode_statistical_mix_desc">Historical statistics and balanced number distribution are used to create combinations.</string>
    <string name="mode_ai_mix_title">AI Mix</string>
    <string name="mode_ai_mix_desc">Combines hot, cold, and recent-frequency scores into a single weighted pick, then filters out oddly-shaped combinations such as all-consecutive numbers or a lopsided odd/even split.</string>
    <string name="mode_smart_coverage_title">Smart Coverage</string>
    <string name="mode_smart_coverage_desc">Smart Coverage creates diverse combinations to reduce unnecessary overlap between your selected games.</string>
    <string name="mode_avoid_popular_title">Avoid Popular Picks</string>
    <string name="mode_avoid_popular_desc">Leans toward numbers and shapes that hand-picked combinations use less often — for example, favoring 32–50 over numbers that can read as a calendar date.</string>

    <string name="generation_disclaimer">All EuroJackpot combinations have exactly the same probability of winning. This tool helps you organize number selection systematically — it does not increase your chances of winning or predict winning numbers.</string>
    <string name="hot_disclaimer">Hot numbers are based on historical frequency and do not have a higher mathematical probability of being drawn.</string>
    <string name="cold_disclaimer">Cold numbers are based on historical frequency and do not have a lower mathematical probability of being drawn.</string>
    <string name="ai_mix_disclaimer">AI Mix blends statistical weighting with rule-based filtering. It does not use machine learning, does not predict outcomes, and does not increase your chances of winning.</string>
    <string name="avoid_popular_disclaimer">Avoiding popular picks does not change your odds of winning — every valid combination is equally likely. It can only affect how a jackpot might be shared if you do win.</string>

