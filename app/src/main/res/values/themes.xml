<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Compose draws all UI; this XML theme only sets the system window background
         shown for a brief moment before Compose takes over, so it stays minimal. -->
    <style name="Theme.EuroJackpotAI" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:windowBackground">@android:color/white</item>
    </style>
</resources>
